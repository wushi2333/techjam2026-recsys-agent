# Copy to .env (gitignored). provider=auto uses a key if present, else dummy.
# OpenAI-compatible (OpenAI, Trae, DeepSeek, vLLM, ...):
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# xAI Grok (if OPENAI_API_KEY is empty, base defaults to https://api.x.ai/v1):
# XAI_API_KEY=
# LLM_MODEL=grok-3-mini

# Force provider: auto | dummy | openai | xai
# LLM_PROVIDER=auto
