# Copy to .env (gitignored).
# DeepSeek OpenAI-compatible:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_REASONING_EFFORT=max
LLM_PROVIDER=auto
# DEEPSEEK_API_KEY=   # optional alias for OPENAI_API_KEY

# AutoDL / 1K job pin (optional; CLI --data-scale 1k also sets this)
# KUAI_CONFIG=config/autodl.toml
# KUAI_DATA_SCALE=1k
# KUAI_DATA_DIR=/root/autodl-tmp/KuaiRand-1K/data
# KUAI_KIT_DIR=/root/autodl-tmp/kuairand-starter-kit
# KUAI_N_WORKERS=1
# KUAI_TRIAL_TIMEOUT_SEC=3600
